{
  "name": "@programinglive/zettly-editor",
  "version": "0.4.0",
  "description": "Shadcn-based WYSIWYG editor for Zettly todo and notes applications.",
  "keywords": [
    "tiptap",
    "wysiwyg",
    "editor",
    "react",
    "shadcn",
    "zettly"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programinglive/zettly-editor.git"
  },
  "homepage": "https://zettly-editor.programinglive.com/",
  "bugs": {
    "url": "https://github.com/programinglive/zettly-editor/issues"
  },
  "sideEffects": [
    "./dist/index.css"
  ],
  "type": "module",
  "bin": {
    "zettly-editor": "./dist/cli.js"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./styles": "./dist/index.css",
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "style": "dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "example:dev": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts",
    "example:preview": "vite preview --config example/vite.config.ts",
    "example:deploy": "npx netlify deploy --site 821407d1-6ae7-499d-9d16-0ca038d7d33e --prod --dir=example/dist --no-build",
    "prepare": "husky",
    "release": "node scripts/release.cjs",
    "release:major": "node scripts/release.cjs major",
    "release:minor": "node scripts/release.cjs minor",
    "release:patch": "node scripts/release.cjs patch"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toggle": "^1.0.3",
    "@sentry/react": "^10.21.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-character-count": "3.34.0",
    "@tiptap/extension-code-block-lowlight": "3.34.0",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide-react": "0.562.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@eslint/js": "9.39.2",
    "@programinglive/commiter": "^1.2.18",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.0.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.33",
    "prettier": "3.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "standard-version": "^9.5.0",
    "tailwindcss": "4.1.18",
    "tsup": "8.5.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "8.53.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "standard-version": {
    "releaseCommitMessageFormat": "chore(release): {{currentTag}} 🚀",
    "commitAll": true,
    "scripts": {
      "postchangelog": "node scripts/update-release-notes.cjs && git add docs/release-notes/RELEASE_NOTES.md"
    },
    "types": [
      {
        "type": "feat",
        "section": "✨ Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "perf",
        "section": "⚡ Performance"
      },
      {
        "type": "refactor",
        "section": "♻️ Refactors"
      },
      {
        "type": "docs",
        "section": "📝 Documentation"
      },
      {
        "type": "style",
        "section": "💄 Styles"
      },
      {
        "type": "test",
        "section": "✅ Tests"
      },
      {
        "type": "build",
        "section": "🏗️ Build System"
      },
      {
        "type": "ci",
        "section": "👷 Continuous Integration"
      },
      {
        "type": "chore",
        "section": "🧹 Chores"
      },
      {
        "type": "revert",
        "section": "⏪ Reverts"
      }
    ]
  }
}
